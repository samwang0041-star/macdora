+    /**
+     * 把同一包名在各屏上的已有根任务搬到目标屏。Android 会为虚拟屏新起一个任务，
+     * 新任务不会继承另一块屏上的登录态；先搬任务再 startActivity 可以保留原有状态。
+     */
+    private static void moveExistingTaskToDisplay(String packageName, int displayId) {
+        try {
+            Object taskManager = Class.forName("android.app.ActivityTaskManager")
+                    .getMethod("getService").invoke(null);
+            List<?> tasks = null;
+            for (Method method : taskManager.getClass().getMethods()) {
+                if (!"getTasks".equals(method.getName())) {
+                    continue;
+                }
+                Class<?>[] parameters = method.getParameterTypes();
+                if (parameters.length == 3) {
+                    tasks = (List<?>) method.invoke(taskManager, 100, false, false);
+                    break;
+                }
+                if (parameters.length == 4) {
+                    tasks = (List<?>) method.invoke(taskManager, 100, false, false, -1);
+                }
+            }
+            if (tasks == null) {
+                return;
+            }
+            Class<?> taskInfo = Class.forName("android.app.TaskInfo");
+            Field taskId = taskInfo.getField("taskId");
+            Field taskDisplay = taskInfo.getField("displayId");
+            Field topActivity = taskInfo.getField("topActivity");
+            Field baseActivity = taskInfo.getField("baseActivity");
+            Method move = taskManager.getClass().getMethod("moveRootTaskToDisplay", int.class, int.class);
+            for (Object task : tasks) {
+                ComponentName top = (ComponentName) topActivity.get(task);
+                ComponentName base = (ComponentName) baseActivity.get(task);
+                boolean matches = top != null && packageName.equals(top.getPackageName())
+                        || base != null && packageName.equals(base.getPackageName());
+                if (!matches) {
+                    continue;
+                }
+                if (taskDisplay.getInt(task) == displayId) {
+                    return;
+                }
+                move.invoke(taskManager, taskId.getInt(task), displayId);
+                Ln.i("Moved existing task " + taskId.getInt(task) + " to display " + displayId);
+                return;
+            }
+        } catch (Throwable e) {
+            Ln.w("task reuse failed: " + e);
+        }
+    }
