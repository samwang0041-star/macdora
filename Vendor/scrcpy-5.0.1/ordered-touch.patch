+        Assert.assertTrue(TouchFinishedPolicy.shouldWaitForFinish(true, ACTION_DOWN, ACTION_DOWN, ACTION_UP));
+        Assert.assertTrue(TouchFinishedPolicy.shouldWaitForFinish(true, ACTION_UP, ACTION_DOWN, ACTION_UP));
+        Assert.assertFalse(TouchFinishedPolicy.shouldWaitForFinish(true, ACTION_MOVE, ACTION_DOWN, ACTION_UP));
+        Assert.assertFalse(TouchFinishedPolicy.shouldWaitForFinish(false, ACTION_UP, ACTION_DOWN, ACTION_UP));
+    }
+
+    @Test
+    public void testMatchingSuccessfulDownAndUpOnSameDisplayCanFinish() {
+        TouchFinishedPolicy policy = new TouchFinishedPolicy();
+        policy.record(7, ACTION_DOWN, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        policy.record(7, ACTION_UP, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+
+        Assert.assertTrue(policy.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+
+    @Test
+    public void testSuccessfulUpWithoutMatchingDownCannotFinish() {
+        TouchFinishedPolicy policy = new TouchFinishedPolicy();
+        policy.record(7, ACTION_UP, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+
+        Assert.assertFalse(policy.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+
+    @Test
+    public void testFailedDownCannotFinish() {
+        TouchFinishedPolicy policy = new TouchFinishedPolicy();
+        policy.record(7, ACTION_DOWN, false, true, NO_DISPLAY, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        policy.record(7, ACTION_UP, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+
+        Assert.assertFalse(policy.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+
+    @Test
+    public void testCrossDisplayCannotFinish() {
+        TouchFinishedPolicy policy = new TouchFinishedPolicy();
+        policy.record(7, ACTION_DOWN, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        policy.record(7, ACTION_UP, true, true, 3, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+
+        Assert.assertFalse(policy.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+
+    @Test
+    public void testDifferentPointerCannotBorrowDown() {
+        TouchFinishedPolicy policy = new TouchFinishedPolicy();
+        policy.record(7, ACTION_DOWN, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        policy.record(8, ACTION_UP, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+
+        Assert.assertFalse(policy.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+
+    @Test
+    public void testFailedOrNonUpAttemptCannotFinish() {
+        TouchFinishedPolicy policy = new TouchFinishedPolicy();
+        policy.record(7, ACTION_DOWN, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        policy.record(7, ACTION_UP, false, true, NO_DISPLAY, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        Assert.assertFalse(policy.canFinish(ACTION_UP, NO_DISPLAY));
+
+        policy.record(7, ACTION_MOVE, true, false, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        Assert.assertFalse(policy.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+
+    @Test
+    public void testDownOrUpWithoutWaitForFinishCannotFinish() {
+        TouchFinishedPolicy downAsync = new TouchFinishedPolicy();
+        downAsync.record(7, ACTION_DOWN, true, false, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        downAsync.record(7, ACTION_UP, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        Assert.assertFalse(downAsync.canFinish(ACTION_UP, NO_DISPLAY));
+
+        TouchFinishedPolicy upAsync = new TouchFinishedPolicy();
+        upAsync.record(7, ACTION_DOWN, true, true, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        upAsync.record(7, ACTION_UP, true, false, 2, ACTION_DOWN, ACTION_UP, NO_DISPLAY);
+        Assert.assertFalse(upAsync.canFinish(ACTION_UP, NO_DISPLAY));
+    }
+}
