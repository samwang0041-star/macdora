@@ -0,0 +1,78 @@
+package com.genymobile.scrcpy.control;
+
+import java.util.Objects;
+
+public final class DisplayStreamConfiguration {
+
+    public static final int MIN_NATIVE_SIZE = 320;
+    public static final int MAX_NATIVE_SIZE = 4096;
+
+    private final long nativeWidth;
+    private final long nativeHeight;
+    private final long density;
+    private final long maxSize;
+    private final long maxFps;
+
+    public DisplayStreamConfiguration(long nativeWidth, long nativeHeight, long density, long maxSize, long maxFps) {
+        this.nativeWidth = nativeWidth;
+        this.nativeHeight = nativeHeight;
+        this.density = density;
+        this.maxSize = maxSize;
+        this.maxFps = maxFps;
+    }
+
+    public boolean isValid() {
+        return nativeWidth >= MIN_NATIVE_SIZE && nativeWidth <= MAX_NATIVE_SIZE
+                && nativeHeight >= MIN_NATIVE_SIZE && nativeHeight <= MAX_NATIVE_SIZE
+                && (density == 320 || density == 400)
+                && (maxSize == 1280 || maxSize == 1920 || maxSize == 2560)
+                && (maxFps == 30 || maxFps == 45 || maxFps == 60);
+    }
+
+    public long getNativeWidth() {
+        return nativeWidth;
+    }
+
+    public long getNativeHeight() {
+        return nativeHeight;
+    }
+
+    public long getDensity() {
+        return density;
+    }
+
+    public long getMaxSize() {
+        return maxSize;
+    }
+
+    public long getMaxFps() {
+        return maxFps;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (o == null || getClass() != o.getClass()) {
+            return false;
+        }
+        DisplayStreamConfiguration that = (DisplayStreamConfiguration) o;
+        return nativeWidth == that.nativeWidth
+                && nativeHeight == that.nativeHeight
+                && density == that.density
+                && maxSize == that.maxSize
+                && maxFps == that.maxFps;
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(nativeWidth, nativeHeight, density, maxSize, maxFps);
+    }
+
+    @Override
+    public String toString() {
+        return nativeWidth + "x" + nativeHeight + "/" + density
+                + " maxSize=" + maxSize + " maxFps=" + maxFps;
+    }
+}
diff -ruN /dev/null b/server/src/main/java/com/genymobile/scrcpy/control/TouchFinishedPolicy.java
--- /dev/null	1970-01-01 00:00:00
+++ b/server/src/main/java/com/genymobile/scrcpy/control/TouchFinishedPolicy.java	2026-10-28 09:51:03
@@ -0,0 +1,59 @@
+package com.genymobile.scrcpy.control;
+
+import java.util.HashMap;
+import java.util.Map;
+
+final class TouchFinishedPolicy {
+
+    private static final class TouchDown {
+        private final boolean success;
+        private final int displayId;
+
+        private TouchDown(boolean success, int displayId) {
+            this.success = success;
+            this.displayId = displayId;
+        }
+    }
+
+    private final Map<Long, TouchDown> touchDowns = new HashMap<>();
+
+    private int lastAction = -1;
+    private boolean lastSuccess;
+    private int lastDisplayId;
+    private boolean lastUpHasMatchingDown;
+
+    TouchFinishedPolicy() {
+    }
+
+    static boolean shouldWaitForFinish(boolean touchscreenFinger, int requestAction, int actionDown, int actionUp) {
+        return touchscreenFinger && (requestAction == actionDown || requestAction == actionUp);
+    }
+
+    void record(long pointerId, int action, boolean success, boolean waitForFinish, int displayId,
+            int actionDown, int actionUp, int noDisplayId) {
+        if (action == actionDown) {
+            touchDowns.put(pointerId, new TouchDown(success && waitForFinish, displayId));
+            lastUpHasMatchingDown = false;
+        } else if (action == actionUp) {
+            TouchDown touchDown = touchDowns.remove(pointerId);
+            lastUpHasMatchingDown = success
+                    && waitForFinish
+                    && touchDown != null
+                    && touchDown.success
+                    && displayId != noDisplayId
+                    && touchDown.displayId == displayId;
+        } else {
+            lastUpHasMatchingDown = false;
+        }
+        lastAction = action;
+        lastSuccess = success;
+        lastDisplayId = displayId;
+    }
+
+    boolean canFinish(int actionUp, int noDisplayId) {
+        return lastAction == actionUp
+                && lastSuccess
+                && lastDisplayId != noDisplayId
+                && lastUpHasMatchingDown;
+    }
+}
