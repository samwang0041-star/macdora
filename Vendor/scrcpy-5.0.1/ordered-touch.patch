--- /dev/null	1970-01-01 00:00:00
+++ b/server/src/test/java/com/genymobile/scrcpy/control/DisplayConfigurationProtocolTest.java	2026-10-28 09:51:03
@@ -0,0 +1,147 @@
+package com.genymobile.scrcpy.control;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+
+public class DisplayConfigurationProtocolTest {
+
+    @Test
+    public void testParseDisplayConfigurationRequest() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        DataOutputStream dos = new DataOutputStream(bos);
+        dos.writeByte(ControlMessage.TYPE_DISPLAY_CONFIGURATION);
+        dos.writeInt(0xF1020304);
+        dos.writeInt(1600);
+        dos.writeInt(2560);
+        dos.writeInt(400);
+        dos.writeInt(1920);
+        dos.writeInt(45);
+        byte[] packet = bos.toByteArray();
+
+        Assert.assertEquals(25, packet.length);
+        ByteArrayInputStream bis = new ByteArrayInputStream(packet);
+        ControlMessage message = new ControlMessageReader(bis).read();
+
+        Assert.assertEquals(ControlMessage.TYPE_DISPLAY_CONFIGURATION, message.getType());
+        Assert.assertEquals(0xF1020304L, message.getSequence());
+        Assert.assertEquals(
+                new DisplayStreamConfiguration(1600, 2560, 400, 1920, 45),
+                message.getDisplayConfiguration());
+        Assert.assertEquals(-1, bis.read());
+    }
+
+    @Test
+    public void testDisplayConfigurationBoundsAreExact() {
+        Assert.assertTrue(new DisplayStreamConfiguration(320, 4096, 320, 1280, 30).isValid());
+        Assert.assertTrue(new DisplayStreamConfiguration(4096, 320, 400, 2560, 60).isValid());
+
+        Assert.assertFalse(new DisplayStreamConfiguration(319, 1000, 320, 1280, 30).isValid());
+        Assert.assertFalse(new DisplayStreamConfiguration(1000, 4097, 320, 1280, 30).isValid());
+        Assert.assertFalse(new DisplayStreamConfiguration(1000, 1000, 360, 1280, 30).isValid());
+        Assert.assertFalse(new DisplayStreamConfiguration(1000, 1000, 320, 1600, 30).isValid());
+        Assert.assertFalse(new DisplayStreamConfiguration(1000, 1000, 320, 1280, 50).isValid());
+    }
+
+    @Test
+    public void testSerializeDisplayConfigurationAcknowledgement() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        new DeviceMessageWriter(bos).write(
+                DeviceMessage.createDisplayConfiguration(0xF1020304L, false));
+
+        Assert.assertArrayEquals(new byte[] {
+                DeviceMessage.TYPE_DISPLAY_CONFIGURATION,
+                (byte) 0xF1, 2, 3, 4,
+                1,
+        }, bos.toByteArray());
+        Assert.assertEquals(DeviceMessage.DISPLAY_CONFIGURATION_SIZE, bos.size());
+
+        bos.reset();
+        new DeviceMessageWriter(bos).write(
+                DeviceMessage.createDisplayConfiguration(7, true));
+        Assert.assertArrayEquals(new byte[] {
+                DeviceMessage.TYPE_DISPLAY_CONFIGURATION,
+                0, 0, 0, 7,
+                0,
+        }, bos.toByteArray());
+    }
+
+    @Test
+    public void testCoordinatorCompletesOnlyMatchingGeneration() throws InterruptedException {
+        DisplayConfigurationCoordinator coordinator = new DisplayConfigurationCoordinator(1000);
+        CountDownLatch finished = new CountDownLatch(1);
+        AtomicBoolean success = new AtomicBoolean();
+        AtomicLong sequence = new AtomicLong();
+        long generation = coordinator.begin(17, (finishedSequence, ok) -> {
+            sequence.set(finishedSequence);
+            success.set(ok);
+            finished.countDown();
+        });
+
+        coordinator.succeed(generation - 1);
+        Assert.assertFalse(finished.await(50, TimeUnit.MILLISECONDS));
+
+        coordinator.succeed(generation);
+        Assert.assertTrue(finished.await(1, TimeUnit.SECONDS));
+        Assert.assertEquals(17, sequence.get());
+        Assert.assertTrue(success.get());
+    }
+
+    @Test
+    public void testNewRequestFailsReplacedRequest() throws InterruptedException {
+        DisplayConfigurationCoordinator coordinator = new DisplayConfigurationCoordinator(1000);
+        CountDownLatch firstFinished = new CountDownLatch(1);
+        CountDownLatch secondFinished = new CountDownLatch(1);
+        AtomicBoolean firstSuccess = new AtomicBoolean(true);
+        AtomicBoolean secondSuccess = new AtomicBoolean();
+
+        long first = coordinator.begin(1, (sequence, success) -> {
+            firstSuccess.set(success);
+            firstFinished.countDown();
+        });
+        long second = coordinator.begin(2, (sequence, success) -> {
+            secondSuccess.set(success);
+            secondFinished.countDown();
+        });
+
+        Assert.assertTrue(firstFinished.await(1, TimeUnit.SECONDS));
+        Assert.assertFalse(firstSuccess.get());
+        coordinator.succeed(first);
+        Assert.assertFalse(secondFinished.await(50, TimeUnit.MILLISECONDS));
+        coordinator.succeed(second);
+        Assert.assertTrue(secondFinished.await(1, TimeUnit.SECONDS));
+        Assert.assertTrue(secondSuccess.get());
+    }
+
+    @Test
+    public void testStopAndTimeoutFailWithoutHanging() throws InterruptedException {
+        CountDownLatch stoppedFinished = new CountDownLatch(1);
+        AtomicBoolean stopSuccess = new AtomicBoolean(true);
+        DisplayConfigurationCoordinator stopped = new DisplayConfigurationCoordinator(1000);
+        stopped.begin(3, (sequence, success) -> {
+            stopSuccess.set(success);
+            stoppedFinished.countDown();
+        });
+        stopped.stop();
+        Assert.assertTrue(stoppedFinished.await(1, TimeUnit.SECONDS));
+        Assert.assertFalse(stopSuccess.get());
+
+        CountDownLatch timedOut = new CountDownLatch(1);
+        AtomicBoolean timeoutSuccess = new AtomicBoolean(true);
+        DisplayConfigurationCoordinator timeout = new DisplayConfigurationCoordinator(50);
+        timeout.begin(4, (sequence, success) -> {
+            timeoutSuccess.set(success);
+            timedOut.countDown();
+        });
+        Assert.assertTrue(timedOut.await(1, TimeUnit.SECONDS));
+        Assert.assertFalse(timeoutSuccess.get());
+    }
+}
