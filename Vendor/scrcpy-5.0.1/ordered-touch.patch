diff -ruN /dev/null b/server/src/main/java/com/genymobile/scrcpy/control/DisplayConfigurationCoordinator.java
--- /dev/null	1970-01-01 00:00:00
+++ b/server/src/main/java/com/genymobile/scrcpy/control/DisplayConfigurationCoordinator.java	2026-10-28 09:51:03
@@ -0,0 +1,109 @@
+package com.genymobile.scrcpy.control;
+
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+
+public final class DisplayConfigurationCoordinator {
+
+    public interface Listener {
+        void onFinished(long sequence, boolean success);
+    }
+
+    private static final ScheduledExecutorService TIMEOUT_EXECUTOR = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread thread = new Thread(r, "display-config-timeout");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    private static final class Pending {
+        private final long generation;
+        private final long sequence;
+        private final Listener listener;
+        private ScheduledFuture<?> timeout;
+
+        private Pending(long generation, long sequence, Listener listener) {
+            this.generation = generation;
+            this.sequence = sequence;
+            this.listener = listener;
+        }
+    }
+
+    private final Object lock = new Object();
+    private final long timeoutMillis;
+
+    private long generation;
+    private Pending pending;
+    private boolean stopped;
+
+    public DisplayConfigurationCoordinator(long timeoutMillis) {
+        if (timeoutMillis <= 0) {
+            throw new IllegalArgumentException("Timeout must be positive");
+        }
+        this.timeoutMillis = timeoutMillis;
+    }
+
+    public long begin(long sequence, Listener listener) {
+        Pending replaced;
+        long requestGeneration;
+        synchronized (lock) {
+            if (stopped) {
+                throw new IllegalStateException("Display configuration coordinator stopped");
+            }
+            replaced = pending;
+            if (replaced != null) {
+                replaced.timeout.cancel(false);
+            }
+
+            requestGeneration = ++generation;
+            Pending next = new Pending(requestGeneration, sequence, listener);
+            pending = next;
+            next.timeout = TIMEOUT_EXECUTOR.schedule(
+                    () -> finish(requestGeneration, false),
+                    timeoutMillis,
+                    TimeUnit.MILLISECONDS);
+        }
+
+        if (replaced != null) {
+            replaced.listener.onFinished(replaced.sequence, false);
+        }
+        return requestGeneration;
+    }
+
+    public void succeed(long requestGeneration) {
+        finish(requestGeneration, true);
+    }
+
+    public void fail(long requestGeneration) {
+        finish(requestGeneration, false);
+    }
+
+    public void stop() {
+        Pending current;
+        synchronized (lock) {
+            stopped = true;
+            current = pending;
+            pending = null;
+            if (current != null) {
+                current.timeout.cancel(false);
+            }
+        }
+        if (current != null) {
+            current.listener.onFinished(current.sequence, false);
+        }
+    }
+
+    private void finish(long requestGeneration, boolean success) {
+        Pending current;
+        synchronized (lock) {
+            if (pending == null || pending.generation != requestGeneration) {
+                return;
+            }
+            current = pending;
+            pending = null;
+            current.timeout.cancel(false);
+        }
+        current.listener.onFinished(current.sequence, success);
+    }
+}
