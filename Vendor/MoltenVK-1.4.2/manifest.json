{
  "schemaVersion": 1,
  "purpose": "Reproducible unmodified upstream MoltenVK for Macdora",
  "buildScript": "scripts/build-moltenvk.sh",
  "downloadDirectory": ".build/moltenvk-upstream/downloads",
  "target": {
    "platform": "macOS",
    "architecture": "arm64",
    "deploymentTarget": "12.0",
    "library": "libMoltenVK.dylib",
