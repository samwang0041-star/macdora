      "license": "licenses/MoltenVK-LICENSE"
    },
    "spirvcross": {
      "revision": "6c09849fe88c48eaed08413aa022aaa136a3a057",
      "url": "https://codeload.github.com/KhronosGroup/SPIRV-Cross/tar.gz/6c09849fe88c48eaed08413aa022aaa136a3a057",
      "sha256": "b81b9956289950570953738e666a031ca32ff64e4fc925eba89f227c42109518",
      "license": "licenses/SPIRV-Cross-LICENSE"
    },
    "headers": {
